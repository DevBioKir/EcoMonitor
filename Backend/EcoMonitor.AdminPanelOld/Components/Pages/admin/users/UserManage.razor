@using EcoMonitor.AdminPanel.Components.Layout
@layout MainLayout

<p>UserManage OK</p>

@page "/admin/userManage"
@using EcoMonitor.EcoMonitor.AdminPanelOld.Components.Layout
@layout MainLayout

<MudText Typo="Typo.h4" Class="mb-2">
    Пользователи
</MudText>

<MudPaper Class="ps-4 mb-3">
    <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
         <MudText Typo="Typo.subtitle1">Управление пользователями</MudText>
         <MudButton Color="Color.Primary"
                    Variant="Variant.Filled"
                    OnClick="OpenCreateDialog">
             Создать пользователя
         </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudTable Items="_users"
              Dense="true"
              Hover="true"
              Loading="_loading">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Имя</MudTh>
            <MudTh>Фамилия</MudTh>
            <MudTh>Почта</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="Имя">@context.Firstname</MudTd>
            <MudTd DataLabel="Фамилия">@context.Surname</MudTd>
            <MudTd DataLabel="Почта">@context.Email</MudTd>
            @* <MudTd DataLabel="Статус"> *@
            @*     @(context.IsBlocked ? "Заблокирован" : "Активен") *@
            @* </MudTd> *@
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="_createDialogOpen">
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_createModel.Firstname" Label="Имя"/>
            <MudTextField @bind-Value="_createModel.Surname" Label="Фамилия"/>
            <MudTextField @bind-Value="_createModel.Email" Label="Почта"/>
            <MudTextField @bind-Value="_createModel.Password" Label="Пароль"
                          InputType="InputType.Password"/>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseCreateDialog">Отмена</MudButton>
        <MudButton Color="Color.Primary"
                   Disabled="_creating"
                   OnClick="CreateUserAsync">
            Создать
        </MudButton>
    </DialogActions>
</MudDialog>