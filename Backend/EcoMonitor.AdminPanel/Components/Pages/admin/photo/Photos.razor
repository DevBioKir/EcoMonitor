@page "/admin/photo"
@using EcoMonitor.AdminPanel.Components.Layout
@using EcoMonitor.AdminPanel.Data.Models
@layout MainLayout

<MudText Typo="Typo.h4" Class="mb-2">
    Фото
</MudText>

@* $1$ <MudPaper Class="ps-4 mb-3"> #1# *@
@*     $1$ <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Rigth"> #1# *@
