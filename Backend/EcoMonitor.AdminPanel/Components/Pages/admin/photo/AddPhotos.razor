@page "/admin/photo/add"
@using EcoMonitor.AdminPanel.Components.Layout
@layout MainLayout

<MudText Typo="Typo.h4" GutterBottom="true">
    Добавить фото контейнера
</MudText>

<MudPaper Class="pa-4">
        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudFileUpload T="IBrowserFile"
                                   AddFile="AddFile"
                                   Accept=".jpg,.jpeg,.png"
                                   MaxFilesAllowed="1">
                        <!-- ... -->
                    </MudFileUpload>
                    
                    @if (!string.IsNullOrEmpty(PreviewImage))
                    {
                        <div class="mt-3">
                            <MudImage Src="@PreviewImage" Width="200" Height="200" Elevation="2" Class="rounded" />
                        </div>
                    }
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudSelect T="string" 
                               Label="Тип контейнера" 
                               Variant="Variant.Outlined"
                               @bind-Value="Model.BinTypeCode"
                               MultiSelection="true">
                        <!-- ... -->
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" Class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="!IsFormValid()"
                               Type="submit">
                        Добавить фото
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="ml-2" Visible="@IsLoading" />
                    </MudButton>
                    
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel">
                        Отмена
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>