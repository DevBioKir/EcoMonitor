@page "/auth/login"
@using EcoMonitor.AdminPanel.Infrastucture.TokenStorage
@using EcoMonitor.Contracts.Contracts.Auth

<MudPaper Class="pa-6 mx-auto my-12" Style="max-width: 420px; border-radius:16px; box-shadow:0 20px 40px rgba(0,0,0,0.1);">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">EcoMonitor Admin</MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-6" Color="Color.Secondary">
        Введите учетные данные администратора
    </MudText>

    <MudTextField @bind-Value="email" Label="Почта" Required="true" FullWidth="true" Class="mb-4" />
    <MudTextField @bind-Value="password" Label="Пароль" InputType="InputType.Password" Required="true" FullWidth="true" Class="mb-4" />

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" OnClick="LoginAsync" Disabled="isLoading">
        @if (isLoading)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
            <span>Вход...</span>
        }
        else
        {
            <span>Войти</span>
        }
    </MudButton>

    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-6">
        EcoMonitor © @DateTime.UtcNow.Year
    </MudText>
</MudPaper>




